---
export function getStaticPaths() {
  return ["en", "es", "fr", "pt", "de"].map((lang) => ({ params: { lang } }));
}
import LegalPage from "../../ui/marketing/LegalPage.astro";
import { dictionary, localeFromPath } from "../../i18n/dictionary";

const locale = localeFromPath(Astro.url.pathname);
const t = await dictionary(locale);
const { title, effectiveDate, ...sections } = t.privacy;
---

<LegalPage title={title} effectiveDate={effectiveDate} sections={sections} description={t.meta.description} />
