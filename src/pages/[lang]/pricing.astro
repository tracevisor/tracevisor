---
export function getStaticPaths() {
  return ["en", "es", "fr", "pt", "de"].map((lang) => ({ params: { lang } }));
}
import SiteLayout from "../../layouts/SiteLayout.astro";
import Icon from "../../ui/Icon.astro";
import { dictionary, localeFromPath } from "../../i18n/dictionary";

const locale = localeFromPath(Astro.url.pathname);
const t = await dictionary(locale);
const p = t.pricing;
const f = p.features;
const userPlan: string | null = null;


type Feature = { text: string; included: boolean; highlight?: boolean };
const plans: {
  id: "basic" | "flex" | "pro";
  name: string;
  description: string;
  monthly: number;
  annual: number;
  popular: boolean;
  features: Feature[];
}[] = [
  {
    id: "basic",
    ...p.plans.basic,
    monthly: 0,
    annual: 0,
    popular: false,
    features: [
      { text: `1 ${f.website}`, included: true },
      { text: `30 ${f.days} ${f.dataRetention}`, included: true },
      { text: f.pageViews, included: true },
      { text: f.coreAnalytics, included: true },
      { text: f.basicExport, included: true },
      { text: f.apiAccess, included: true },
      { text: f.customEvents, included: false },
      { text: f.emailReports, included: false },
      { text: f.co2Reporting, included: false },
    ],
  },
  {
    id: "flex",
    ...p.plans.flex,
    monthly: 12,
    annual: 79.99,
    popular: true,
    features: [
      { text: `5 ${f.websites}`, included: true },
      { text: `6 ${f.months} ${f.dataRetention}`, included: true },
      { text: f.pageViews, included: true },
      { text: f.coreAnalytics, included: true },
      { text: f.customEvents, included: true },
      { text: f.utmTracking, included: true },
      { text: f.gis, included: true },
      { text: f.dataExport, included: true },
      { text: f.emailReports, included: true },
      { text: f.apiAccess, included: true },
      { text: f.co2Reporting, included: false },
      { text: f.publicDashboards, included: false },
    ],
  },
  {
    id: "pro",
    ...p.plans.pro,
    monthly: 15,
    annual: 99.99,
    popular: false,
    features: [
      { text: `${p.unlimited} ${f.websites}`, included: true },
      { text: `${p.unlimited} ${f.dataRetention}`, included: true },
      { text: f.pageViews, included: true },
      { text: `${p.everythingIn} Flex +`, included: true, highlight: true },
      { text: f.co2Reporting, included: true },
      { text: f.publicDashboards, included: true },
      { text: f.prioritySupport, included: true },
    ],
  },
];

const money = (n: number) => (Number.isInteger(n) ? `$${n}` : `$${n.toFixed(2)}`);
---

<SiteLayout title={p.title} description={p.metaDescription}>
  <section class="mx-auto max-w-site px-4 pt-14 pb-16 sm:px-6 lg:pt-20">
    <div class="flex flex-col items-start gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-xl">
        <h1>{p.title}</h1>
        <p class="mt-2 text-text">{p.subtitle}</p>
      </div>
      <fieldset class="flex items-center gap-2">
        <legend class="sr-only">{p.monthly} / {p.annual}</legend>
        <div class="flex rounded-md border border-line bg-surface p-0.5">
          <input type="radio" name="billing" id="billing-monthly" value="monthly" class="peer/monthly sr-only" checked />
          <label for="billing-monthly" class="cursor-pointer rounded-sm px-3 py-1.5 text-[0.8125rem] font-medium text-muted transition-colors duration-150 peer-checked/monthly:bg-elevated peer-checked/monthly:text-fg peer-checked/monthly:shadow-soft">
            {p.monthly}
          </label>
          <input type="radio" name="billing" id="billing-annual" value="annual" class="peer/annual sr-only" />
          <label for="billing-annual" class="cursor-pointer rounded-sm px-3 py-1.5 text-[0.8125rem] font-medium text-muted transition-colors duration-150 peer-checked/annual:bg-elevated peer-checked/annual:text-fg peer-checked/annual:shadow-soft">
            {p.annual}
          </label>
        </div>
        <span class="badge">{p.save}</span>
      </fieldset>
    </div>

    <div class="mt-10 grid gap-px overflow-hidden rounded-lg border border-line bg-line lg:grid-cols-3">
      {
        plans.map((plan) => {
          const current = userPlan === plan.id;
          const links = null;
          return (
            <div class="flex flex-col bg-bg p-6">
              <div class="flex items-center justify-between gap-2">
                <h2 class="text-lg">{plan.name}</h2>
                {plan.popular && <span class="badge">{p.mostPopular}</span>}
              </div>
              <p class="mt-1 min-h-10 text-[0.8125rem] text-muted">{plan.description}</p>
              <div class="mt-5 flex items-baseline gap-1.5 tabular-nums">
                {plan.monthly === 0 ? (
                  <span class="text-3xl font-semibold tracking-tight text-fg">{p.free}</span>
                ) : (
                  <>
                    <span data-billing="monthly" class="text-3xl font-semibold tracking-tight text-fg">{money(plan.monthly)}</span>
                    <span data-billing="monthly" class="text-[0.8125rem] text-muted">{p.perMonth}</span>
                    <span data-billing="annual" class="text-3xl font-semibold tracking-tight text-fg">{money(plan.annual)}</span>
                    <span data-billing="annual" class="text-[0.8125rem] text-muted">{p.perYear}</span>
                  </>
                )}
              </div>
              <p class="mt-1 h-4 text-2xs text-muted">
                {plan.monthly > 0 && (
                  <>
                    <span data-billing="monthly">{p.billedMonthly}</span>
                    <span data-billing="annual">{p.billedAnnually}</span>
                  </>
                )}
              </p>
              <div class="mt-5">
                {current ? (
                  <span class="btn btn-secondary w-full" aria-disabled="true">{p.currentPlan}</span>
                ) : links ? (
                  <>
                    <a data-billing="monthly" href={links.monthly} target="_blank" rel="noopener" class:list={["btn w-full", plan.popular ? "btn-primary" : "btn-secondary"]}>
                      {p.subscribe}
                    </a>
                    <a data-billing="annual" href={links.annual} target="_blank" rel="noopener" class:list={["btn w-full", plan.popular ? "btn-primary" : "btn-secondary"]}>
                      {p.subscribe}
                    </a>
                  </>
                ) : (
                  <a href={`/${locale}/login`} class="btn btn-secondary w-full">{p.getStarted}</a>
                )}
              </div>
              <ul class="mt-6 flex flex-col gap-2.5 border-t border-line pt-5">
                {plan.features.map((feature) => (
                  <li class:list={["flex items-start gap-2.5 text-[0.8125rem]", feature.included ? "text-text" : "text-faint line-through decoration-line-strong"]}>
                    {feature.included ? <Icon name="check" class="mt-0.5 size-3.5! shrink-0 text-fg" /> : <span class="mt-0.5 flex size-3.5 shrink-0 items-center justify-center text-faint">–</span>}
                    <span class:list={[feature.highlight && "font-medium text-fg"]}>{feature.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>
    <p class="mt-4 text-2xs text-muted">{p.footnote}</p>
  </section>
</SiteLayout>

<style>
  [data-billing="annual"],
  body:has(#billing-annual:checked) [data-billing="monthly"] {
    display: none;
  }
  body:has(#billing-annual:checked) a[data-billing="annual"] {
    display: inline-flex;
  }
  body:has(#billing-annual:checked) span[data-billing="annual"] {
    display: inline;
  }
</style>
