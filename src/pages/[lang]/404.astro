---
export function getStaticPaths() {
  return ["en", "es", "fr", "pt", "de"].map((lang) => ({ params: { lang } }));
}
import SiteLayout from "../../layouts/SiteLayout.astro";
import Icon from "../../ui/Icon.astro";
import { dictionary, localeFromPath } from "../../i18n/dictionary";

const locale = localeFromPath(Astro.url.pathname);
const t = await dictionary(locale);
---

<SiteLayout title={t.notFound.title} description={t.notFound.body} noindex>
  <section class="mx-auto flex max-w-prose flex-col items-start gap-4 px-4 py-24 sm:px-6 sm:py-32">
    <span class="font-mono text-2xs uppercase tracking-[0.14em] text-muted">404</span>
    <h1>{t.notFound.title}</h1>
    <p class="text-text">{t.notFound.body}</p>
    <a href={`/${locale}`} class="btn btn-secondary mt-2">
      <Icon name="arrow-left" />
      {t.notFound.home}
    </a>
  </section>
</SiteLayout>
