---
export function getStaticPaths() {
  return ["en", "es", "fr", "pt", "de"].map((lang) => ({ params: { lang } }));
}
import SiteLayout from "../../layouts/SiteLayout.astro";
import Icon from "../../ui/Icon.astro";
import ProductPreview from "../../ui/marketing/ProductPreview.astro";
import type { IconName } from "../../ui/icons.generated";
import { dictionary, localeFromPath } from "../../i18n/dictionary";

const locale = localeFromPath(Astro.url.pathname);
const t = await dictionary(locale);
const h = t.home;
const signedIn = false;
const features: { icon: IconName; title: string; body: string }[] = [
  { icon: "activity", ...h.features.realtime },
  { icon: "earth", ...h.features.geography },
  { icon: "smartphone", ...h.features.devices },
  { icon: "zap", ...h.features.campaigns },
];
const help = [
  { href: `/${locale}/faq`, label: h.help.faq },
  { href: `/${locale}/contact`, label: h.help.contact },
];
---

<SiteLayout title={h.title.replace(/\.$/, "")}>
  <section class="mx-auto grid max-w-site items-center gap-10 px-4 pt-16 pb-12 sm:px-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-14 lg:pt-24 lg:pb-20">
    <div class="flex flex-col items-start gap-5">
      <span class="badge">{h.eyebrow}</span>
      <h1 class="text-[clamp(2.25rem,1.5rem+2.8vw,3.75rem)] leading-[1.05] tracking-[-0.035em]">{h.title}</h1>
      <p class="max-w-md text-[1.0625rem] text-text">{h.subtitle}</p>
      <div class="mt-1 flex flex-wrap gap-2">
        {
          signedIn ? (
            <a href={`/${locale}/dashboard`} class="btn btn-primary btn-lg">
              {h.viewDashboard}
            </a>
          ) : (
            <a href={`/${locale}/login`} class="btn btn-primary btn-lg">
              {h.startFree}
            </a>
          )
        }
        <a href={`/${locale}/pricing`} class="btn btn-secondary btn-lg">{h.seePricing}</a>
      </div>
      <ul class="mt-2 flex flex-wrap gap-x-5 gap-y-2 text-[0.8125rem] text-muted">
        {
          [h.proof.gdpr, h.proof.noCookies, h.proof.setup].map((item) => (
            <li class="flex items-center gap-2">
              <Icon name="check" class="size-3.5! text-fg" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
    <ProductPreview t={h.preview} />
  </section>

  <section class="border-t border-line">
    <div class="mx-auto max-w-site px-4 py-14 sm:px-6 lg:py-20">
      <div class="max-w-xl">
        <h2>{h.alternative.title}</h2>
        <p class="mt-2 text-text">{h.alternative.body}</p>
      </div>
      <ul class="mt-10 grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {
          features.map((f) => (
            <li class="flex flex-col gap-3 bg-bg p-5">
              <span class="flex size-8 items-center justify-center rounded-md border border-line bg-surface text-fg">
                <Icon name={f.icon} />
              </span>
              <h3 class="text-[0.9375rem]">{f.title}</h3>
              <p class="text-[0.8125rem] leading-relaxed text-muted">{f.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-t border-line bg-surface">
    <div class="mx-auto max-w-site px-4 py-14 sm:px-6 lg:py-20">
      <h2>{h.how.title}</h2>
      <ol class="mt-8 grid gap-8 md:grid-cols-3">
        {
          h.how.steps.map((step, i) => (
            <li class="flex flex-col gap-2 border-t border-line-strong pt-4">
              <span class="font-mono text-2xs tracking-[0.14em] text-muted">0{i + 1}</span>
              <h3 class="text-[0.9375rem]">{step.title}</h3>
              <p class="text-[0.8125rem] leading-relaxed text-muted">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="border-t border-line">
    <div class="mx-auto max-w-site px-4 py-14 sm:px-6 lg:py-20">
      <h2 class="max-w-xl">{h.trust.title}</h2>
      <div class="mt-8 grid gap-8 md:grid-cols-3">
        {
          h.trust.items.map((item) => (
            <div class="flex flex-col gap-2">
              <h3 class="text-[0.9375rem]">{item.title}</h3>
              <p class="text-[0.8125rem] leading-relaxed text-muted">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-line">
    <div class="mx-auto grid max-w-site gap-8 px-4 py-14 sm:px-6 lg:grid-cols-2 lg:py-20">
      <div>
        <h2>{h.help.title}</h2>
        <p class="mt-2 max-w-md text-text">{h.help.body}</p>
      </div>
      <ul class="divide-y divide-line rounded-lg border border-line">
        {
          help.map((item) => (
            <li>
              <a href={item.href} class="group flex items-center justify-between gap-4 px-4 py-3.5 text-[0.9375rem] text-fg transition-colors duration-150 hover:bg-surface">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</SiteLayout>
